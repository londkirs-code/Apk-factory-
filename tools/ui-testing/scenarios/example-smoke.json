{
  "name": "example-smoke",
  "description": "Template: copy to apps/<app>/ui-tests/smoke.json and adapt the texts/ids to your app.",
  "grant_permissions": true,
  "screenshot_every_step": false,
  "stop_on_failure": true,
  "steps": [
    {"action": "launch", "clear_data": true},
    {"action": "wait", "seconds": 2},
    {"action": "screenshot", "name": "launch"},
    {"action": "tap", "any": "Allow", "timeout": 3, "optional": true, "note": "dismiss a permission/onboarding dialog if one appears"},
    {"action": "assert_foreground"},
    {"action": "swipe", "direction": "up"},
    {"action": "screenshot", "name": "scrolled"},
    {"action": "back"},
    {"action": "screenshot", "name": "after-back"}
  ]
}
