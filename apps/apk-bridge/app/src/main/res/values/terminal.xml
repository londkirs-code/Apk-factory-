<resources>
    <!-- WhatsApp dark-mode palette for the chat-style ADB Terminal. -->
    <color name="terminal_chat_bg">#0B141A</color>
    <color name="terminal_header">#1F2C34</color>
    <style name="TerminalTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/terminal_chat_bg</item>
        <item name="android:statusBarColor">@color/terminal_header</item>
        <item name="android:navigationBarColor">@color/terminal_chat_bg</item>
        <item name="android:colorAccent">#00A884</item>
        <item name="android:colorControlActivated">#00A884</item>
        <item name="android:textColorHighlight">#5500A884</item>
    </style>
</resources>
