<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Declared in both apps (same signing key) so the order of installation does not matter. -->
    <permission
        android:name="com.londkirs.apkbridge.permission.CONTROL_WIFI"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name">
        <receiver
            android:name=".EnableWifiReceiver"
            android:exported="true"
            android:permission="com.londkirs.apkbridge.permission.CONTROL_WIFI">
            <intent-filter>
                <action android:name="com.londkirs.apkbridge.wifihelper.ENABLE_WIFI" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
