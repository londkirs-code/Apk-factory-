{
  "name": "antigravity-start-agy",
  "grant_permissions": true,
  "steps": [
    {
      "action": "launch",
      "clear_data": true
    },
    {
      "action": "tap",
      "text": "Wait",
      "optional": true
    },
    {
      "action": "shell",
      "cmd": "run-as com.londkirs.antigravityremote sh -c 'mkdir -p files/bin && echo \"#!/system/bin/sh\" > files/bin/agy && echo \"echo STAND-IN-AGY started; pwd; echo BROWSER=\\$BROWSER; exit 0\" >> files/bin/agy && chmod 700 files/bin/agy && echo test-stand-in > files/agy.version && cat files/bin/agy'",
      "expect": "STAND-IN-AGY"
    },
    {
      "action": "back",
      "optional": true
    },
    {
      "action": "launch"
    },
    {
      "action": "tap",
      "text": "Wait",
      "optional": true
    },
    {
      "action": "wait_for",
      "text": "Start Antigravity",
      "timeout": 20
    },
    {
      "action": "screenshot",
      "name": "home-installed"
    },
    {
      "action": "tap",
      "text": "Start Antigravity"
    },
    {
      "action": "wait",
      "seconds": 5
    },
    {
      "action": "tap",
      "text": "Wait",
      "optional": true
    },
    {
      "action": "screenshot",
      "name": "agy-session"
    },
    {
      "action": "assert_foreground"
    }
  ]
}
