{
  "name": "antigravity-v4-screens",
  "grant_permissions": true,
  "stop_on_failure": false,
  "steps": [
    {
      "action": "launch",
      "clear_data": true
    },
    {
      "action": "wait_for",
      "text": "Setup guide",
      "timeout": 20
    },
    {
      "action": "tap",
      "desc": "Connect to a computer instead"
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "launch"
    },
    {
      "action": "wait",
      "seconds": 2
    },
    {
      "action": "screenshot",
      "name": "01-home-tip"
    },
    {
      "action": "wait",
      "seconds": 2
    },
    {
      "action": "tap",
      "text": "Got it",
      "optional": true
    },
    {
      "action": "screenshot",
      "name": "02-home-empty"
    },
    {
      "action": "tap",
      "desc": "New chat"
    },
    {
      "action": "wait",
      "seconds": 3
    },
    {
      "action": "screenshot",
      "name": "03-chat-empty"
    },
    {
      "action": "wait",
      "seconds": 2
    },
    {
      "action": "tap",
      "text": "Got it",
      "optional": true
    },
    {
      "action": "tap",
      "text": "Message"
    },
    {
      "action": "type",
