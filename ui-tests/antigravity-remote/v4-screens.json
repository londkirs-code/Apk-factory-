    {
      "action": "back"
    },
    {
      "action": "back"
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "wait",
      "seconds": 2
    },
    {
      "action": "tap",
      "text": "Got it",
      "optional": true
    },
    {
      "action": "screenshot",
      "name": "08-home-draft"
    },
    {
      "action": "long_press",
      "text": "New chat"
    },
    {
      "action": "screenshot",
      "name": "09-home-selection"
    },
    {
      "action": "back"
    },
    {
      "action": "tap",
      "desc": "More"
    },
    {
      "action": "screenshot",
      "name": "10-home-menu"
    },
    {
      "action": "tap",
      "text": "Settings"
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "screenshot",
      "name": "11-settings"
