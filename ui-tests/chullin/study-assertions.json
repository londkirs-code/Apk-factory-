    },
    {
      "action": "assert_text",
      "text": "הכל שוחטין"
    },
    {
      "action": "scroll_to",
      "text": "הבא",
      "direction": "up",
      "max_swipes": 6
    },
    {
      "action": "assert_text",
      "text": "הבא"
    },
    {
      "action": "screenshot",
      "name": "study-start"
    },
    {
      "action": "scroll_to",
      "text": "גמרא",
      "direction": "down",
      "max_swipes": 6
    },
    {
      "action": "tap",
      "text": "גמרא",
      "exact": true
    },
    {
      "action": "scroll_to",
      "text": "גמרא",
      "direction": "down",
      "max_swipes": 6
    },
    {
      "action": "assert_text",
      "text": "✓ גמרא"
    },
    {
      "action": "scroll_to",
      "text": "גמרא",
      "direction": "down",
      "max_swipes": 6
    },
    {
      "action": "tap",
      "text": "✓ גמרא",
