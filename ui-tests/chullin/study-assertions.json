    {
      "action": "assert_text",
      "text": "גמורים: 0"
    },
    {
      "action": "screenshot",
      "name": "overview"
    },
    {
      "action": "tap",
      "text": "פרקים",
      "exact": true
    },
    {
      "action": "assert_text",
      "text": "הכל שוחטין"
    },
    {
      "action": "tap",
      "text": "הכל שוחטין"
    },
    {
      "action": "assert_text",
      "text": "אותו ואת בנו",
      "optional": true
    },
    {
      "action": "screenshot",
      "name": "perakim"
